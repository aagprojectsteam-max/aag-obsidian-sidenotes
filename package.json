{
  "name": "aag-sidenotes",
  "version": "0.2.0",
  "description": "Obsidian plugin for sidebar notes linked to the paragraph under the cursor.",
  "main": "main.js",
  "scripts": {
    "dev": "tsc -w -skipLibCheck",
    "build": "tsc --skipLibCheck --outDir dist/build --inlineSourceMap false --inlineSources false",
    "test:full": "node scripts/test.cjs",
    "test": "node scripts/test.cjs",
    "typecheck": "tsc --noEmit --skipLibCheck",
    "verify": "npm run typecheck && npm test && npm run build",
    "release:stage": "node scripts/release.cjs stage",
    "release:check": "node scripts/release.cjs check"
  },
  "keywords": [
    "obsidian",
    "obsidian-plugin",
    "paragraph-notes",
    "block-notes"
  ],
  "author": "AAG",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^20.11.0",
    "obsidian": "^1.13.0",
    "typescript": "^5.3.0"
  },
  "dependencies": {
    "@codemirror/state": "^6.5.0",
    "@codemirror/view": "^6.38.6"
  },
  "private": true
}
